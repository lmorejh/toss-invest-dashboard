# Copy to .env.local and fill in. Expo loads .env.local automatically for app.config.ts.

# Google Maps SDK key(s). Restrict by iOS bundle id / Android package + SHA-1 in Google Cloud.
GOOGLE_MAPS_API_KEY=
# Optional: separate keys per platform (override the one above)
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=

# Base URL of the review proxy in ../matzip-map/server (e.g. https://matzip-reviews.example.workers.dev)
REVIEW_API_URL=
